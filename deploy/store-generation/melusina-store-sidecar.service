[Unit]
Description=Melusina Store Sidecar (signed desired-generation producer)
Documentation=https://github.com/hrbrlife/melusina-static-store/blob/main/docs/COMPONENT_RELEASE_PROTOCOL.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/melusina/store/store.config.json
ConditionFileIsExecutable=/opt/melusina-store/current/bin/melusina-store-sidecar

[Service]
Type=simple
User=root
Group=root
UMask=0077
# Controller-owned runtime identity for /release-info. The leading '-' permits a
# first boot to fail closed until a governed Store-sidecar component apply writes
# the marker; a missing marker must never be treated as a valid release identity.
EnvironmentFile=-/var/lib/melusina-store/runtime/melusina-store-sidecar.env
ExecStart=/opt/melusina-store/current/bin/melusina-store-sidecar -config /etc/melusina/store/store.config.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/melusina/store
# The rendered config (estate-store-config-render) puts every root the Store
# writes under /var/lib/melusina-store: dist-publish, private-app-candidates,
# app-catalog-generations, migrations, catalog-source and the enrollment
# state. That directory exists before the first start, because
# genesis-dist-init refuses to run without it. systemd refuses to start a
# unit (226/NAMESPACE) when a path listed here without a leading '-' is
# missing; store_unit_namespace_paths_test.go admits only paths that exist
# before the first start.
ReadWritePaths=/var/lib/melusina-store
StandardOutput=journal
StandardError=journal
SyslogIdentifier=melusina-store-sidecar

[Install]
WantedBy=multi-user.target
