# Local runtime-path module for scripts/default-bazaar-release.sh.
# Keep this outside Git. It references existing key files but contains no key
# material itself. The launcher verifies that the public Store identity is the
# active default Bazaar v2 identity before any release action.
export MEL_RELEASE_STORE_PUBKEY=/absolute/path/to/default-bazaar-store.pubkey.json
export MEL_RELEASE_PUBLISHER_KEY=/absolute/path/to/governed-publisher.key.json
