# Local runtime-path module for scripts/default-bazaar-release.sh.
# Keep this outside Git. It references existing key files but contains no key
# material itself. The launcher verifies that the public Store identity is the
# active default Bazaar v2 identity before any release action, and mel-release
# refuses it unless its signing key is the estate profile's store.operatorKey.
#
# The launcher sources this file only when MEL_RELEASE_RUNTIME_ENV names it and
# MEL_RELEASE_RUNTIME_ENV_SHA256 pins its bytes:
#   export MEL_RELEASE_RUNTIME_ENV=/absolute/path/to/default-bazaar-release.env
#   export MEL_RELEASE_RUNTIME_ENV_SHA256="$(scripts/release-inputs.py digest "$MEL_RELEASE_RUNTIME_ENV")"
# Nothing below has a default: each missing value is refused by name
# (release-input-missing:NAME). scripts/release-inputs.json declares them all.
# Values are used exactly as written: one with leading or trailing whitespace
# is refused (release-input-whitespace:NAME), never trimmed.
export MEL_RELEASE_STORE_PUBKEY=/absolute/path/to/default-bazaar-store.pubkey.json
export MEL_RELEASE_PUBLISHER_KEY=/absolute/path/to/governed-publisher.key.json
# The owner-signed estate profile and its reviewed digest (the profileSha256
# printed by `melusina-store-sidecar estate-profile-review`). mel-release takes
# the Store, registry, master mint and release authority from this profile only.
export MEL_RELEASE_ESTATE_PROFILE=/absolute/path/to/estate-profile.json
export MEL_RELEASE_ESTATE_PROFILE_SHA256=REPLACE_WITH_THE_64_CHARACTER_LOWERCASE_PROFILE_SHA256
# Release state: a fresh directory, or one already stamped for this estate.
export MEL_RELEASE_STATE_DIR=/absolute/path/to/mel-release-state
# Credentials, named explicitly (comma-separated absolute paths for members).
export MEL_RELEASE_AUTHOR_KEYPAIR=/absolute/path/to/publisher.json
export MEL_RELEASE_SQUADS_MEMBERS=/absolute/path/to/member-1.json,/absolute/path/to/member-2.json,/absolute/path/to/member-3.json
# The Squads SDK node_modules and its tree digest (release-inputs.py digest DIR).
export MEL_RELEASE_SQUADS_NODE_MODULES=/absolute/path/to/node_modules
export MEL_RELEASE_SQUADS_NODE_MODULES_SHA256=REPLACE_WITH_THE_TREE_DIGEST
# The canonical Squads vault executor: scripts/squads-vault-exec.js in a
# checkout of the deployer at the commit scripts/release-inputs.json names. Its
# pin is in the repository; no other copy is accepted. The providers run it,
# and the Store's own Squads helper, under
# sidecar/melusina-store-sidecar/scripts/node-module-confinement.cjs: a module
# its pinned node_modules lacks is refused as not found, never loaded from an
# ancestor node_modules, NODE_PATH or a global folder.
export MEL_RELEASE_SQUADS_EXECUTOR=/absolute/path/to/melusina-os-deployer/scripts/squads-vault-exec.js
# The Pearl tool binary and its sha256.
export MEL_RELEASE_PEARL_TOOL=/absolute/path/to/melusina-pearl-tool
export MEL_RELEASE_PEARL_TOOL_SHA256=REPLACE_WITH_THE_BINARY_SHA256
