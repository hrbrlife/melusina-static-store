# Local runtime-path module for scripts/default-bazaar-release.sh.
# Keep this outside Git. It references existing key files but contains no key
# material itself. The launcher verifies that the public Store identity is the
# active default Bazaar v2 identity before any release action, and mel-release
# refuses it unless its signing key is the estate profile's store.operatorKey.
export MEL_RELEASE_STORE_PUBKEY=/absolute/path/to/default-bazaar-store.pubkey.json
export MEL_RELEASE_PUBLISHER_KEY=/absolute/path/to/governed-publisher.key.json
# The owner-signed estate profile and its reviewed digest (the profileSha256
# printed by `melusina-store-sidecar estate-profile-review`). mel-release takes
# the Store, registry, master mint and release authority from this profile only.
export MEL_RELEASE_ESTATE_PROFILE=/absolute/path/to/estate-profile.json
export MEL_RELEASE_ESTATE_PROFILE_SHA256=REPLACE_WITH_THE_64_CHARACTER_LOWERCASE_PROFILE_SHA256
