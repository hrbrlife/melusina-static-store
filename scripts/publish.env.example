# Copy to repo-root .publish.env (gitignored) and fill in.
# Canonical devnet RPC for the Pearl ceremony + verify-release.
export MELUSINA_RPC_URL="https://devnet.helius-rpc.com/?api-key=<YOUR_DEVNET_KEY>"
export MELUSINA_ATTEST_OFFLINE="0"   # 1 = test-only: allow offline stubs (build-store bypass)
