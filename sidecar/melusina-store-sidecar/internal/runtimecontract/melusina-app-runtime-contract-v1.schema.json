{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazaar.melusina-os.org/schemas/melusina-app-runtime-contract-v1.schema.json",
  "title": "Melusina app runtime contract v1",
  "description": "A release-bound declaration of the visible launch and sidecar functionality that must be proven after installation. This is not itself a test result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "app", "sidecars", "launchProbe", "fixtures", "cleanup"],
  "properties": {
    "$schema": { "const": "https://bazaar.melusina-os.org/schemas/melusina-app-runtime-contract-v1.schema.json" },
    "schema": { "const": "melusina-app-runtime-contract-v1" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "version", "spkSha256", "appHash"],
      "properties": {
        "appId": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "spkSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "appHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "sidecars": {
      "type": "array",
      "items": { "$ref": "#/$defs/sidecar" }
    },
    "launchProbe": { "$ref": "#/$defs/visibleProbe" },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture" }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
      }
    }
  },
  "$defs": {
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host", "port", "transport", "tls", "capabilities", "safeProbe"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "host": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.sidecar\\.(?:host|hypervisor(?:\\.shared)?|local|remote(?:\\.shared)?)$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "transport": { "const": "https" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "serverName", "trust", "minimumVersion"],
          "properties": {
            "required": { "const": true },
            "serverName": { "type": "string" },
            "trust": { "const": "system-ca" },
            "minimumVersion": { "enum": ["TLS1.2", "TLS1.3"] }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "http-out" },
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
        },
        "safeProbe": { "$ref": "#/$defs/probeResult" }
      }
    },
    "visibleProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps", "expectedResult"],
      "properties": {
        "kind": { "const": "visible-ui" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/probeResult" } },
        "expectedResult": { "type": "string", "minLength": 3 }
      }
    },
    "probeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expectedResult"],
      "properties": {
        "action": { "type": "string", "minLength": 3 },
        "expectedResult": { "type": "string", "minLength": 3 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "setup"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "purpose": { "type": "string", "minLength": 3 },
        "setup": { "type": "string", "minLength": 3 }
      }
    }
  }
}
