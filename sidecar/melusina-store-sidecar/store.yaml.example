# melusina-store-sidecar — per-operator config (documented target format).
#
# NOTE: the current scaffold loads the equivalent JSON (see
# store.config.example.json); YAML loading lands when the melusina-attest
# module deps are wired for the gated /publish path (post-C1).
#
# ONE binary runs both the root store and any reseller store — only this file
# and the three attest shards differ between operators.

license_nft_mint: "<base58 License NFT mint of the operating license>"
program_id: "7anRCW8UAFwdSAAxkrK7TmptukNKY74nZrNPfRKzzWLb"
domain: "store.example.org"        # bare host only (no scheme/port/path); store_domain_hash = sha256(ascii_lower(strip_trailing_dot(domain)))
store_id: "melusina-store"
# reseller_nft_mint: "<optional base58 ResellerEntry NFT mint>"   # set for reseller stores
root_store_url: "https://melusina-os.org"   # base binary + basic apps are MIRRORED from here when this is not the root
public_base_url: "https://bazaar.melusina-os.org"  # THIS store's own public origin (behind the bazaar TLS edge). Used to build the signed update manifest's bundle_url; unset => GET /update/manifest.json fails closed (503). Set to https://bazaar.<domain>.

policy:
  allowed_tiers: ["regular"]       # capability tiers this store may list
  require_scan_report: true        # reject publishes without an attested clean scan report
  accept_publishers:               # REQUIRED for /publish; empty fails closed
    - "<allowed publisher signing pubkey or ReleaseEntry PDA>"

rpc_url: "<Solana RPC endpoint>"   # e.g. the Helius devnet endpoint (public devnet times out)
listen_addr: ":8443"
dist_dir: "dist-publish"           # the build output to serve (relative to CWD or absolute)

tls:
  cert_path: "/etc/melusina/store/tls/cert.pem"
  key_path: "/etc/melusina/store/tls/key.pem"

boot_identity:
  # Omit this block for a read-only store (/publish 503).
  shards_dir: "/etc/melusina/store/shards"
  sidecar_id: "store"
  chain_id: "solana:devnet"
  key_version: 1
  # Optional: bind the SidecarIdentityEntry to a public edge certificate while
  # the sidecar still serves container-local TLS internally.
  tls_cert_path: "/etc/melusina/store/boot-identity-tls-cert.pem"
