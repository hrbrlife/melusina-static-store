{
  "schema": "melusina.sidecar-pda-vectors/v1",
  "comment": [
    "Cross-language vector for the licence-registry sidecar cascade PDAs.",
    "A consumer derives every expected address from inputs and seeds, in its own implementation, and compares",
    "address AND bump. The seeds block is checked against the program source by tests/sidecar-pda-vectors.test.mjs;",
    "do not edit it by hand. Regenerate with the generator named below.",
    "rootStoreSidecarId is the protocol constant a NEW estate's root Store uses (scripts/estate/lib/profile.mjs",
    "ROOT_STORE_SIDECAR_ID); melusina-os-root-store-v2 is the retiring estate's rotation label and appears only",
    "in the observed vector."
  ],
  "generator": "scripts/estate/testdata/gen_sidecar_pda_vectors.py (solders Pubkey.find_program_address)",
  "rootStoreSidecarId": "store",
  "seedSources": {
    "global_sidecar": "programs/license-registry/src/instructions/sidecar_approval.rs ApproveGlobalSidecar (init)",
    "reseller_sidecar": "programs/license-registry/src/instructions/sidecar_approval.rs ApproveResellerSidecar (init)",
    "local_sidecar": "programs/license-registry/src/instructions/sidecar_approval.rs ApproveLocalSidecar (init)",
    "sidecar_identity": "programs/license-registry/src/instructions/attestation.rs RegisterSidecarIdentity (init)"
  },
  "seeds": {
    "global_sidecar": [
      {
        "literal": "global_sidecar"
      },
      {
        "pubkey": "masterNftMint"
      },
      {
        "utf8": "sidecarId"
      }
    ],
    "reseller_sidecar": [
      {
        "literal": "reseller_sidecar"
      },
      {
        "pubkey": "resellerNftMint"
      },
      {
        "utf8": "sidecarId"
      }
    ],
    "local_sidecar": [
      {
        "literal": "local_sidecar"
      },
      {
        "pubkey": "licenseNftMint"
      },
      {
        "utf8": "sidecarId"
      }
    ],
    "sidecar_identity": [
      {
        "literal": "sidecar_identity"
      },
      {
        "pubkey": "licenseNftMint"
      },
      {
        "utf8": "sidecarId"
      },
      {
        "u32le": "keyVersion"
      }
    ]
  },
